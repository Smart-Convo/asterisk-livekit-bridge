FROM golang:1.24-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends libopus-dev libopusfile-dev libsoxr-dev pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN go mod tidy && go test ./... && go build -trimpath -ldflags="-s -w" -o /out/asterisk-livekit-bridge .
